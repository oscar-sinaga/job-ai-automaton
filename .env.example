# Copy to .env and fill in real values. .env is git-ignored.
# Every variable here is documented in docs/14_DEPLOYMENT_PLAN.md §3.

OSCAR_ENV=local

# Postgres DSN. Matches docker-compose.yml's db service by default.
OSCAR_DATABASE_URL=postgresql+psycopg://oscar:oscar@127.0.0.1:5432/oscar

# Shared secret for web/extension/mobile clients (docs/03 §4). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OSCAR_API_KEY=

# Comma-separated allowlist. Add the extension origin (chrome-extension://<id>)
# once it exists (M1).
OSCAR_CORS_ORIGINS=http://127.0.0.1:5173

# Analytics day/week boundaries use this timezone, not UTC (docs/10 §7).
OSCAR_TIMEZONE=Asia/Jakarta

# --- LLM (Milestone 3, ADR-025: OpenAI) -----------------------------------
OPENAI_API_KEY=
OSCAR_LLM_MODEL=gpt-4.1
OSCAR_LLM_PARSER_MODEL=gpt-4.1
